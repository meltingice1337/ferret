{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ferret",
  "version": "0.8.1",
  "identifier": "com.ferret.app",
  "build": {
    "beforeDevCommand": "yarn dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "yarn build",
    "beforeBundleCommand": "yarn sign:indexer",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Ferret",
        "width": 1320,
        "height": 820,
        "minWidth": 760,
        "minHeight": 480,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "visible": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' https: data: blob: http://fs.localhost fs: http://thumb.localhost thumb:",
        "media-src": "'self' blob: http://fs.localhost fs:",
        "font-src": "'self' data: blob: http://fs.localhost fs:",
        "connect-src": "'self' ipc: http://ipc.localhost http://fs.localhost fs: data: blob:",
        "worker-src": "'self' blob:",
        "frame-src": "'none'",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' https: data: blob: http://fs.localhost fs: http://thumb.localhost thumb:",
        "media-src": "'self' blob: http://fs.localhost fs:",
        "font-src": "'self' data: blob: http://fs.localhost fs:",
        "connect-src": "'self' ipc: http://ipc.localhost http://fs.localhost fs: data: blob: ws://localhost:1420",
        "worker-src": "'self' blob:",
        "frame-src": "'none'",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "publisher": "meltingice1337",
    "copyright": "© 2026 meltingice1337",
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "resources": { "target/signed/ferret-indexer.exe.sig": "ferret-indexer.exe.sig" },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE1RTY5M0EyMzk2RTZENTcKUldSWGJXNDVvcFBtRlc3UTJNbC93UWNVbUpwdmdiSkw0S0tORXVtbkovWllaN0x3YXFWUmhTM0UK",
      "endpoints": ["https://github.com/meltingice1337/ferret/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
